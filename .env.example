# Database Configuration
DB_USER=artist_admin
DB_PASSWORD=artist_secure_pass_2026
DB_NAME=artist_os_db
DB_HOST=localhost
DB_PORT=5432

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────
# Spotify
# Get from: https://developer.spotify.com/dashboard → Create App
# ──────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Your artist ID — from your Spotify profile URL:
# https://open.spotify.com/artist/XXXXXXXX  ← this part
SPOTIFY_ARTIST_ID=your_spotify_artist_id

# ──────────────────────────────────────────
# Instagram / Meta
# Get from: https://developers.facebook.com/tools/explorer
# Requires: Professional Instagram account linked to a Facebook Page
# Token type: Page Access Token (not Basic Display token)
# Expires: ~60 days — regenerate in Graph API Explorer when expired
# ──────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_page_access_token
META_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
META_API_VERSION=v18.0

# ──────────────────────────────────────────
# Meta Ads (Phase 2 — leave blank for now)
# Get from: https://business.facebook.com → Ad Accounts
# ──────────────────────────────────────────
META_ADS_ACCOUNT_ID=your_meta_ads_account_id

# ──────────────────────────────────────────
# AI Assistant (Phase 3 — leave blank for now)
# Get from: https://platform.openai.com → API Keys
# ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
